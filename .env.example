# telegram
SERVICE_NAME=my vpn
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_ID=123456789
ADMIN_COMMAND=admin
TEST_USER_TG_ID=0

# subscription links shown to users (base URL only, without /s/ or /jsnn/)
SUBSCRIPTION_BASE_URL=https://vpn.example.com:2096

# 3x-ui
XUI_HOST=https://127.0.0.1:2053
XUI_API_TOKEN=replace_with_3x_ui_api_token
XUI_INBOUND_IDS=1,2
TRIAL_HWID_LIMIT=1
PAID_HWID_LIMIT=3

# trial and subscription rules
TRIAL_HOURS=12
TRIAL_DURATION_HOURS=24
TRIAL_LIMIT=4
SUBSCRIPTION_DELETE_AFTER_DAYS=3
MIN_PAID_DEVICES=3
MAX_PAID_DEVICES=10
BASE_MONTHLY_PRICE=80
EXTRA_DEVICE_MONTHLY_PRICE=30
CURRENCY_CODE=RUB
CURRENCY_SYMBOL=₽

# payments: current adapter is RollyPay; replace the adapter when switching providers
PAYMENT_PROVIDER=rollypay
PAYMENT_API_BASE_URL=https://rollypay.io
PAYMENT_API_KEY=replace_with_payment_api_key
PAYMENT_SIGNING_SECRET=replace_with_webhook_signing_secret
PAYMENT_CALLBACK_URL=https://vpn.example.com/payment/webhook
PAYMENT_WEBHOOK_PATH=/payment/webhook
PAYMENT_TEST=true
PAYMENT_DEFAULT_PRICE=80
PAYMENT_DEFAULT_DAYS=30
PAYMENT_ORDER_PREFIX=vpn

# optional public links
CHANNEL_URL=https://t.me/your_channel
CHANNEL_USERNAME=@your_channel
ADMIN_URL=https://t.me/your_channel
SUPPORT_URL=https://t.me/your_support
PRIVACY_URL=https://example.com/privacy
OFFER_URL=https://example.com/offer

# optional Telegram visuals (Telegram file IDs from your own bot)
MAIN_MENU_PHOTO=
TRIAL_MENU_PHOTO=
MENU_PHOTOS=
PREMIUM_EMOJI_ID=

# local storage and webhook server
DATABASE_PATH=bot.db
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8443
WEBHOOK_SSL_CERT_PATH=
WEBHOOK_SSL_KEY_PATH=
