# copy to .env.test for isolated testing only; never use production credentials
SERVICE_NAME=Kitty VPN TEST
BOT_TOKEN=replace_with_a_separate_test_bot_token
ADMIN_ID=123456789
ADMIN_COMMAND=testadmin
TEST_USER_TG_ID=0

# Must point to a dedicated test 3x-ui panel and test client, never production.
SUBSCRIPTION_BASE_URL=https://test-vpn.example.com:2096
XUI_SUBSCRIPTION_PATH=/s/
XUI_JSON_SUBSCRIPTION_PATH=/jsnn/
XUI_HOST=https://test-panel.example.com:2053
XUI_API_TOKEN=replace_with_test_panel_token
XUI_INBOUND_IDS=1
TRIAL_HWID_LIMIT=1
PAID_HWID_LIMIT=3

TRIAL_DURATION_HOURS=1
MIN_PAID_DEVICES=1
MAX_PAID_DEVICES=3
BASE_MONTHLY_PRICE=1
EXTRA_DEVICE_MONTHLY_PRICE=1
THREE_MONTH_DISCOUNT_PERCENT=0
SUBSCRIPTION_MONTH_DAYS=1
CURRENCY_CODE=RUB
CURRENCY_SYMBOL=₽

# Until a replacement provider is selected, test RollyPay credentials only.
PAYMENT_PROVIDER=rollypay
PAYMENT_API_BASE_URL=https://rollypay.io
PAYMENT_API_KEY=replace_with_payment_test_api_key
PAYMENT_SIGNING_SECRET=replace_with_payment_test_webhook_secret
PAYMENT_CALLBACK_URL=https://test-vpn.example.com/payment/webhook
PAYMENT_WEBHOOK_PATH=/payment/webhook
PAYMENT_TEST=true
PAYMENT_ORDER_PREFIX=vpn_test

CHANNEL_URL=https://t.me/test_channel
CHANNEL_USERNAME=@test_channel
ADMIN_URL=https://t.me/test_admin
SUPPORT_URL=https://t.me/test_support
PRIVACY_URL=https://example.com/test-privacy
OFFER_URL=https://example.com/test-offer

MAIN_MENU_PHOTO=
TRIAL_MENU_PHOTO=
MENU_PHOTOS=
PREMIUM_EMOJI_ID=

DATABASE_PATH=test_bot.db
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8444
WEBHOOK_SSL_CERT_PATH=
WEBHOOK_SSL_KEY_PATH=
